# ─── MindMerge AI — Environment Variables ───────────────────
# Copy this file to .env and fill in your values.

# GEMINI_API_KEY: Required for AI-powered content generation.
# Get yours at https://aistudio.google.com/apikey
# This key is ONLY used server-side (server/api.ts) and is never sent to the browser.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# API_PORT: Port for the Express backend server (default: 3001)
API_PORT=3001

# APP_URL: The URL where this app is hosted (used for OG tags, callbacks, etc.)
APP_URL="http://localhost:3000"
